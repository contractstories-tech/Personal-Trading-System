{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "card.schema.json",
 "title": "Strategy card v6",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "code",
  "strategy_class",
  "lineage",
  "version",
  "registry",
  "hypothesis",
  "trade_direction",
  "horizon",
  "data_resolution",
  "evaluation",
  "selection_method",
  "universe",
  "features",
  "unknown_overrides",
  "params",
  "composites",
  "gates",
  "size_dependent_checks",
  "lifecycle",
  "sizing",
  "construction",
  "proposed_execution_rule",
  "exit_rules",
  "cooldown",
  "review_triggers",
  "corporate_action_policy",
  "ca_state_held",
  "signal_void_on",
  "benchmark",
  "ai_inputs",
  "validation",
  "retirement"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "const": 6
  },
  "code": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
  },
  "strategy_class": {
   "type": "string",
   "pattern": "^[a-z_]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"
  },
  "registry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "closure_sha256"
   ],
   "properties": {
    "version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "closure_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "hypothesis": {
   "type": "string",
   "minLength": 80
  },
  "trade_direction": {
   "type": "string"
  },
  "horizon": {
   "type": "string"
  },
  "data_resolution": {
   "type": "string"
  },
  "evaluation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "entry_triggers",
    "risk_trigger"
   ],
   "properties": {
    "entry_triggers": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/trigger"
     }
    },
    "risk_trigger": {
     "$ref": "#/$defs/trigger"
    }
   }
  },
  "selection_method": {
   "type": "string"
  },
  "universe": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "base",
    "exclude_sectors",
    "filters"
   ],
   "properties": {
    "base": {
     "type": "string"
    },
    "exclude_sectors": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string"
     }
    },
    "filters": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "features": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]*$"
   }
  },
  "unknown_overrides": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "params": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/param"
   }
  },
  "composites": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/composite"
   }
  },
  "gates": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "code",
     "expr",
     "unknown_blocks"
    ],
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^G[0-9]+$"
     },
     "expr": {
      "type": "string",
      "minLength": 1
     },
     "unknown_blocks": {
      "type": "boolean"
     }
    }
   }
  },
  "size_dependent_checks": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "code",
     "expr"
    ],
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^S[0-9]+$"
     },
     "expr": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "ranking": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "expr"
   ],
   "properties": {
    "expr": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "lifecycle": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "signal_ttl"
   ],
   "properties": {
    "signal_ttl": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "value",
      "unit"
     ],
     "properties": {
      "value": {
       "type": "integer",
       "minimum": 1
      },
      "unit": {
       "type": "string"
      }
     }
    }
   }
  },
  "sizing": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "method",
    "params",
    "formula"
   ],
   "properties": {
    "method": {
     "type": "string"
    },
    "params": {
     "type": "object",
     "additionalProperties": {
      "oneOf": [
       {
        "const": "OPEN"
       },
       {
        "type": "number",
        "exclusiveMinimum": 0
       }
      ]
     }
    },
    "formula": {
     "type": "string",
     "minLength": 1
    },
    "revised_formula": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "proposed_execution_rule": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scope",
    "entry_ref",
    "entry_high",
    "target_qty",
    "tranches",
    "on_exhausted",
    "exit_execution"
   ],
   "properties": {
    "scope": {
     "type": "string",
     "const": "simulation_and_plan_only"
    },
    "entry_ref": {
     "type": "string",
     "minLength": 1
    },
    "entry_high": {
     "type": "string",
     "minLength": 1
    },
    "target_qty": {
     "type": "string",
     "minLength": 1
    },
    "revised_target_qty": {
     "type": "string",
     "minLength": 1
    },
    "tranches": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/tranche"
     }
    },
    "on_exhausted": {
     "type": "string"
    },
    "exit_execution": {
     "type": "string"
    }
   }
  },
  "stop": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "evaluation_order",
    "initial",
    "update"
   ],
   "properties": {
    "evaluation_order": {
     "type": "string",
     "const": "test_then_update"
    },
    "initial": {
     "type": "string",
     "minLength": 1
    },
    "update": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "exit_rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "code",
     "cadence",
     "expr"
    ],
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^X[0-9]+$"
     },
     "cadence": {
      "type": "string"
     },
     "expr": {
      "type": "string",
      "minLength": 1
     },
     "weekday": {
      "type": "string"
     },
     "on_out_of_domain": {
      "type": "string"
     }
    }
   }
  },
  "cooldown": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trading_days",
    "applies_after"
   ],
   "properties": {
    "trading_days": {
     "type": "integer",
     "minimum": 0
    },
    "applies_after": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "review_triggers": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "corporate_action_policy": {
   "type": "string"
  },
  "ca_state_held": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string"
   }
  },
  "signal_void_on": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string"
   }
  },
  "benchmark": {
   "type": "string"
  },
  "secondary_benchmark": {
   "type": "string"
  },
  "ai_inputs": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "permitted"
   ],
   "properties": {
    "permitted": {
     "type": "boolean"
    },
    "declared_features": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "validation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "protocol",
    "warm_up_years",
    "evaluable_years",
    "holdout_years"
   ],
   "properties": {
    "protocol": {
     "type": "string",
     "const": "document_04"
    },
    "warm_up_years": {
     "type": "integer",
     "minimum": 0
    },
    "evaluable_years": {
     "type": "integer",
     "minimum": 1
    },
    "holdout_years": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "retirement": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "min_closed_positions",
    "min_years",
    "metric",
    "window_years",
    "threshold"
   ],
   "properties": {
    "min_closed_positions": {
     "type": "integer",
     "minimum": 1
    },
    "min_years": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "metric": {
     "type": "string",
     "enum": [
      "rolling_alpha_vs_secondary_benchmark_after_costs",
      "rolling_return_vs_benchmark_after_costs"
     ]
    },
    "window_years": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "threshold": {
     "type": "number"
    }
   }
  },
  "lineage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "code",
    "derived_from"
   ],
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    },
    "derived_from": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     }
    }
   }
  },
  "construction": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "max_positions",
    "capacity_order",
    "residual_cash"
   ],
   "properties": {
    "max_positions": {
     "oneOf": [
      {
       "const": "OPEN"
      },
      {
       "type": "integer",
       "minimum": 1
      }
     ]
    },
    "capacity_order": {
     "type": "string"
    },
    "residual_cash": {
     "type": "string"
    }
   }
  },
  "void_parameters": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "number"
    }
   }
  }
 },
 "$defs": {
  "trigger": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trigger"
   ],
   "properties": {
    "trigger": {
     "type": "string"
    },
    "weekday": {
     "type": "string"
    },
    "minutes": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "param": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "value"
   ],
   "properties": {
    "value": {
     "oneOf": [
      {
       "const": "CALIBRATE"
      },
      {
       "type": "number"
      }
     ]
    },
    "calibration": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "q",
      "feature",
      "population",
      "period",
      "sampling"
     ],
     "properties": {
      "statistic": {
       "type": "string"
      },
      "q": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1
      },
      "feature": {
       "type": "string"
      },
      "population": {
       "type": "object",
       "additionalProperties": {
        "type": "boolean"
       }
      },
      "period": {
       "type": "string",
       "const": "design_only"
      },
      "sampling": {
       "type": "string"
      }
     }
    }
   }
  },
  "composite": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "inputs",
    "min_inputs_known"
   ],
   "properties": {
    "inputs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "code",
       "direction"
      ],
      "properties": {
       "code": {
        "type": "string"
       },
       "direction": {
        "type": "string"
       }
      }
     }
    },
    "min_inputs_known": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "tranche": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "n",
    "weight",
    "limit",
    "qty",
    "attempt_policy",
    "recheck_gates",
    "recheck_failure"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "weight": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 1
    },
    "limit": {
     "type": "string",
     "minLength": 1
    },
    "qty": {
     "type": "string",
     "minLength": 1
    },
    "attempt_policy": {
     "type": "string"
    },
    "recheck_gates": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "recheck_failure": {
     "type": "string"
    },
    "first_attempt_sessions_after_tranche_1": {
     "type": "integer",
     "minimum": 1
    },
    "retry_sessions": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "holdout_ledger.schema.json",
 "title": "Append-only record of historical dates exposed to research, per strategy lineage",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "lineage",
  "entries"
 ],
 "properties": {
  "lineage": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "entry_id",
     "card_version",
     "card_sha256",
     "exposed_from",
     "exposed_to",
     "kind",
     "run_id",
     "recorded_at"
    ],
    "properties": {
     "entry_id": {
      "type": "string"
     },
     "card_version": {
      "type": "string"
     },
     "card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "exposed_from": {
      "type": "string",
      "format": "date"
     },
     "exposed_to": {
      "type": "string",
      "format": "date"
     },
     "kind": {
      "enum": [
       "design",
       "sealed_holdout"
      ]
     },
     "run_id": {
      "type": "string"
     },
     "recorded_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  }
 }
}
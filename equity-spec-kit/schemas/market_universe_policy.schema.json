{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "market_universe_policy.schema.json",
 "title": "Market-eligible universe policy",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "policy_version",
  "top_n",
  "entry_sessions",
  "exit_buffer",
  "exit_sessions",
  "exclude_series",
  "exclude_reason"
 ],
 "properties": {
  "policy_version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "top_n": {
   "type": "integer",
   "minimum": 50,
   "maximum": 2000
  },
  "entry_sessions": {
   "type": "integer",
   "minimum": 1
  },
  "exit_buffer": {
   "type": "integer",
   "minimum": 0
  },
  "exit_sessions": {
   "type": "integer",
   "minimum": 1
  },
  "exclude_series": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string"
   }
  },
  "exclude_reason": {
   "type": "string",
   "minLength": 20
  }
 }
}